{% extends 'base.html.twig' %}
{# Home page. Gets: name, tasks, error (from index.php) #}

{% block body %}
<div class="content">
    <h1>Good Morning, {{ name }}</h1>
    <p>Manage your tasks efficiently and effectively.</p>
</div>
<div class="dashboard-cards">
    <div class="dashboard-card">
        <h2>Task List</h2>
        <p>View and manage your tasks.</p>
        <a href="tasks.php" class="button">Go to Tasks</a>
    </div>
</div>
<div class="todo-section">
    <h2>To-Do List</h2>
    {% if tasks %}
        <ul class="todo-list">
            {% for task in tasks %}
                {# data-id is read by tasks.js to know which task was clicked #}
                <li class="todo-item {{ task.is_done ? 'todo-item--done' }}" data-id="{{ task.id }}">
                    <input type="checkbox" class="todo-item_checkbox" {{ task.is_done ? 'checked' }}>
                    <span class="todo-item_title">{{ task.title }}</span>
                    <span class="todo-item_due-date">{{ task.due_date }}</span>
                    <a href="edit_task.php?id={{ task.id }}" class="btn-edit">Edit</a>
                    <a href="#" class="btn-delete">Delete</a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {# Always on the page but hidden, so tasks.js can show it when the last task is deleted #}
    <p id="empty-message" style="display: {{ tasks ? 'none' : 'block' }};">No tasks to show.</p>

    <button class="btn-add-task" id="add-task-btn">Add New Task</button>

    {# The form is hidden until the button is clicked (see tasks.js) #}
    {% include 'partials/create_task.html.twig' %}
</div>

<script src="tasks.js"></script>
{% endblock %}
