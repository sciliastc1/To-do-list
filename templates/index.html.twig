{% extends 'base.html.twig' %}

{% block body %}
<div class="content">
    <h1>Good Morning, {{ name }}</h1>
    <p>Manage your tasks efficiently and effectively.</p>
</div>
<div class="dashboard-cards">
    <div class="dashboard-card">
        <h2>Task List</h2>
        <p>View and manage your tasks.</p>
        <a href="tasks.php" class="button">Go to Tasks</a>
    </div>
    <div class="dashboard-card">
        <h2>Reports</h2>
        <p>Generate reports on your task progress.</p>
        <a href="reports.php" class="button">Go to Reports</a>
    </div>
</div>
<div class="todo-section">
    <h2>To-Do List</h2>
    {% if tasks %}
        <ul class="todo-list">
            {% for task in tasks %}
                <li class="todo-item {{ task.is_done ? 'todo-item--done' }}">
                    <form action="toggle_task.php" method="POST" style="display:inline;">
                        <input type="hidden" name="task_id" value="{{ task.id }}">
                        <input type="checkbox" class="todo-item_checkbox" name="is_done" value="1"
                               {{ task.is_done ? 'checked' }} onchange="this.form.submit()">
                    </form>
                    <span class="todo-item_title">{{ task.title }}</span>
                    <span class="todo-item_due-date">{{ task.due_date }}</span>
                    <a href="edit_task.php?id={{ task.id }}" class="btn-edit">Edit</a>
                    <a href="delete_task.php?id={{ task.id }}" class="btn-delete">Delete</a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>No tasks found. Add a new task to get started!</p>
    {% endif %}

    <button class="btn-add-task" onclick="window.location.href='index.php?action=add'">
        Add New Task
    </button>

    {% if show_form %}
        {% include 'partials/create_task.html.twig' %}
    {% endif %}
</div>
{% endblock %}
