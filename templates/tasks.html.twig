{% extends 'base.html.twig' %}
{# Tasks page. Gets: tasks, status_labels, today, error (from tasks.php) #}

{% block title %}Task List - Task Flow{% endblock %}

{% block body %}
<div class="content">
    <h1>Task List</h1>
    <p>All your tasks in one place.</p>
</div>

<div class="todo-section">
    {# Search box. tasks.js asks search_tasks.php which tasks match #}
    <input type="search" id="task-search" class="task-search" placeholder="Search tasks..." aria-label="Search tasks">

    {# Filter tabs. The numbers in the spans are filled in by tasks.js #}
    <div class="task-filters">
        <a href="#" class="task-filter task-filter--active" data-filter="all">
            All <span class="task-filter_count" data-count="all"></span>
        </a>
        {% for key, label in status_labels %}
            <a href="#" class="task-filter" data-filter="{{ key }}">
                {{ label }} <span class="task-filter_count" data-count="{{ key }}"></span>
            </a>
        {% endfor %}
    </div>

    {% if tasks %}
        <ul class="todo-list">
            {% for task in tasks %}
                {# Overdue = not done and the due date is before today #}
                {% set overdue = not task.is_done and task.due_date < today %}
                <li class="todo-item {{ task.is_done ? 'todo-item--done' }}" data-id="{{ task.id }}" data-status="{{ task.status }}">
                    <input type="checkbox" class="todo-item_checkbox" {{ task.is_done ? 'checked' }}>

                    <div class="todo-item_body">
                        <span class="todo-item_title">{{ task.title }}</span>
                        {% if task.description %}
                            <span class="todo-item_description">{{ task.description }}</span>
                        {% endif %}
                    </div>

                    <span class="badge badge--{{ task.priority }}">{{ task.priority|capitalize }}</span>
                    <span class="badge badge--status">{{ status_labels[task.status] ?? task.status }}</span>
                    <span class="todo-item_due-date {{ overdue ? 'todo-item_due-date--overdue' }}">
                        {{ overdue ? 'Overdue · ' }}{{ task.due_date }}
                    </span>

                    <a href="edit_task.php?id={{ task.id }}" class="btn-edit">Edit</a>
                    <a href="#" class="btn-delete">Delete</a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {# Shown by tasks.js when the filter has no tasks #}
    <p id="empty-message" style="display: {{ tasks ? 'none' : 'block' }};">No tasks to show.</p>

    <button class="btn-add-task" id="add-task-btn">Add New Task</button>

    {% include 'partials/create_task.html.twig' %}
</div>

<script src="tasks.js"></script>
{% endblock %}
